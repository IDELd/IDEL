# Продовые переменные бэкенда (копируется на сервер как backend/.env)
#
# Скопируйте файл на сервер и заполните значения:
#   cp backend/.env.production.example backend/.env
#   nano backend/.env
#
# Сгенерировать секреты (на сервере или локально):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=5001
NODE_ENV=production

# --- JWT и шифрование ---
JWT_SECRET=
JWT_EXPIRES_IN=30d
SESSION_ENC_KEY=
CSRF_SECRET=
MESSAGE_ENC_KEY=
BOT_CODE_SECRET=

# --- Почтовый сервер (Gmail: пароль приложения, не обычный пароль) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ИДЕЛЬ <ваш@gmail.com>

# --- Адрес фронтенда на GitHub Pages (для ссылок в письмах) ---
FRONTEND_URL=https://ваш-логин.github.io/IDEL/

# --- Supabase (медиа + зеркало премиума/описаний) ---
SUPABASE_URL=https://omapsdhihnkvtnsypzuw.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_MEDIA_BUCKET=media
MAX_MEDIA_FILES=2000
MEDIA_TTL_DAYS=30

# --- Постоянный диск (задаётся в docker-compose, можно не дублировать) ---
# DB_PATH=/data/database.db
# UPLOAD_DIR=/data/uploads
