# URL of the backend (see backend/.env for the server's own port).
# Defaults to http://localhost:5001 if not set.
VITE_API_URL=http://localhost:5001

# --- Серверные переменные (backend/.env) ---
# PORT=5001
# JWT_SECRET=<длинный случайный секрет>
# JWT_EXPIRES_IN=30d
#
# Ключ AES-256-GCM для шифрования IP и User-Agent в таблице user_sessions.
# 32 байта в hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_ENC_KEY=
#
# Секрет для подписи CSRF-токенов. Если не задан, берётся JWT_SECRET.
# CSRF_SECRET=
#
# Ключ AES-256-GCM для шифрования текста личных сообщений (32 байта hex).
# Если не задан, используется SESSION_ENC_KEY.
# MESSAGE_ENC_KEY=
#
# FRONTEND_URL=http://localhost:5173
#
# --- SMTP (письма: подтверждение регистрации, коды входа ботов, сброс пароля) ---
# Если SMTP_USER/SMTP_PASS не заданы, письма не отправляются, а ссылка/код
# выводятся в консоль сервера — сценарий можно проверить локально.
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=no-reply@example.com
# SMTP_PASS=<пароль приложения>
# SMTP_FROM=ИДЕЛЬ <no-reply@example.com>
#
# --- Supabase (хранилище медиа: картинки постов, видео, голосовые) ---
# Аватарки и обложки остаются локальными; крупные медиа уходят в Supabase Storage.
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role key>
# SUPABASE_MEDIA_BUCKET=media
# MAX_MEDIA_FILES=2000        # максимум файлов в хранилище
# MEDIA_TTL_DAYS=30           # файлы старше N дней первыми уходят при переполнении
#
# --- Деплой (Docker/Render: постоянный диск) ---
# DB_PATH=/data/database.db
# UPLOAD_DIR=/data/uploads
# BOT_CODE_SECRET=<случайный секрет для кодов входа ботов>
#
# Полная инструкция по деплою: DEPLOY.md

